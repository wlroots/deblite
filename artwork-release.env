# Pinned DebLite artwork release consumed by the ISO build.
#
# Wallpapers live in their own repository and are published as
# deblite-artwork-X.Y.Z.tar.gz on artwork-vX.Y.Z tags. Keep
# DEBLITE_ARTWORK_VERSION in sync with that tag.
#
# Environment variables of the same name override these values. Leave
# DEBLITE_ARTWORK_REPO empty to derive <owner>/deblite-artwork from this
# repository's git origin; GitHub Actions sets it explicitly.
: "${DEBLITE_ARTWORK_REPO:=}"
: "${DEBLITE_ARTWORK_VERSION:=0.1.0}"

# Optional hard pin. Empty means verify the tarball against the release's
# SHA256SUMS asset.
: "${DEBLITE_ARTWORK_SHA256:=}"

# Optional local overrides for offline development. DEBLITE_ARTWORK_DIR points
# at a directory containing wallpapers; DEBLITE_ARTWORK_ARCHIVE at a release
# tarball. Both skip the download.
: "${DEBLITE_ARTWORK_DIR:=}"
: "${DEBLITE_ARTWORK_ARCHIVE:=}"
