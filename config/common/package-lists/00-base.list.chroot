# DebLite base system — shared by every edition.
# Deliberately no recommends/suggests: live-build is configured with
# --apt-recommends false and --no-install-recommends --no-install-suggests.

# Kernel and microcode. Hardware firmware lives in 05-firmware.list.chroot.
linux-image-amd64
wireless-regdb
bluez-firmware
intel-microcode
amd64-microcode

# Boot, partitioning, filesystems
initramfs-tools
cryptsetup
cryptsetup-initramfs
gdisk
parted
dosfstools
e2fsprogs
xfsprogs
btrfs-progs
mtools
rsync
squashfs-tools
zstd
grub2-common
grub-efi-amd64-bin
grub-pc-bin
efibootmgr
os-prober

# Live session
live-boot
live-config
live-config-systemd
live-tools
user-setup
iproute2
uuid-runtime

# Core system
systemd
systemd-sysv
dbus
sudo
# Virtual machine guests: QEMU/KVM and VMware.
qemu-guest-agent
open-vm-tools
locales
console-setup
keyboard-configuration
tzdata
ca-certificates
curl
wget
gnupg
bash-completion
less
htop
neovim
firewalld
network-manager
zram-tools
systemd-timesyncd

