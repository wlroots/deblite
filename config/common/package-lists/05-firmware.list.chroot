# Firmware for hardware found in laptops, desktops and workstations.
#
# Kept separate from 00-base.list.chroot so scripts/verify-iso.sh can assert
# that every package listed here actually made it into the image.
#
# Deliberately excluded:
#   firmware-linux, firmware-linux-nonfree
#       metapackages that only duplicate entries already selected explicitly;
#       the explicit list is easier to verify and to document
#   firmware-b43-installer, firmware-b43legacy-installer
#       download proprietary blobs during postinst; not reproducible offline
#   firmware-bnx2, firmware-bnx2x, firmware-cavium, firmware-marvell-prestera,
#   firmware-myricom, firmware-netronome, firmware-netxen, firmware-qlogic
#       server/enterprise network adapters, not desktop hardware
#   firmware-ast, firmware-samsung, firmware-qcom-soc, firmware-qcom-media
#       server BMC, ARM SoC and Exynos-only firmware
#   firmware-nvidia-tesla-535-gsp
#       data-centre Tesla GPUs

firmware-amd-graphics
firmware-ath9k-htc
firmware-atheros
firmware-brcm80211
firmware-carl9170
firmware-cirrus
firmware-intel-graphics
firmware-intel-misc
firmware-intel-sound
firmware-ipw2x00
firmware-ivtv
firmware-iwlwifi
firmware-libertas
firmware-linux-free
firmware-mediatek
firmware-misc-nonfree
firmware-nvidia-graphics
firmware-nvidia-gsp
firmware-realtek
firmware-siano
firmware-sof-signed
firmware-ti-connectivity
firmware-zd1211
