#!/bin/sh
# Add a UEFI entry that boots the live kernel without its EFI stub.
#
# GRUB's "linux" command normally hands the initrd to the kernel through
# EFI_LOAD_FILE2_PROTOCOL: GRUB only registers a protocol, and the kernel's EFI
# stub fetches the initrd itself while boot services are still active. Some
# firmware loses that handoff; the kernel then boots without an initramfs and
# panics with "VFS: Unable to mount root fs on unknown-block(0,0)". GRUB falls
# back to its classic x86 loader (the one Secure Boot systems use) when the
# kernel PE image reports an image version below 1. That loader places the
# initrd in memory itself and does not depend on the firmware at all, so ship a
# copy of the kernel with the field cleared and a menu entry that uses it.
set -eu

kernel=
for candidate in live/vmlinuz-*-amd64; do
    if [ -f "$candidate" ]; then
        kernel=$candidate
        break
    fi
done
if [ -z "$kernel" ]; then
    echo "error: no live kernel found" >&2
    exit 1
fi

if grep -q "UEFI compatibility mode" boot/grub/grub.cfg; then
    exit 0
fi

version=${kernel#live/vmlinuz-}
initrd="live/initrd.img-$version"
if [ ! -f "$initrd" ]; then
    echo "error: $initrd not found" >&2
    exit 1
fi

compat="live/vmlinuz-$version-compat"
cp -f "$kernel" "$compat"

# The PE header starts at e_lfanew (LE32 at 0x3c), followed by the signature
# (4 bytes) and the COFF header (20 bytes). MajorImageVersion is at offset 44
# of the optional header for both PE32 and PE32+.
lfanew=$(od -An -tu4 -j 60 -N 4 "$kernel" | tr -d '[:space:]')
opt=$((lfanew + 24))
magic=$(od -An -tx2 -j "$opt" -N 2 "$kernel" | tr -d '[:space:]')
if [ "$magic" != "020b" ]; then
    echo "error: $kernel is not a PE32+ image (magic $magic)" >&2
    exit 1
fi
printf '\000\000' | dd of="$compat" bs=1 seek=$((opt + 44)) conv=notrunc status=none

if [ "$(od -An -tx2 -j $((opt + 44)) -N 2 "$compat" | tr -d '[:space:]')" != "0000" ]; then
    echo "error: could not clear the PE image version of $compat" >&2
    exit 1
fi

block=$(mktemp)
trap 'rm -f "$block"' EXIT
cat >"$block" <<EOF

# Boots the same kernel without its EFI stub. The PE image version of this copy
# is 0, so GRUB uses its classic x86 loader, which loads the initrd itself
# instead of relying on the EFI_LOAD_FILE2_PROTOCOL handoff.
if [ "\$grub_platform" = "efi" ]; then
menuentry "Live system (amd64, UEFI compatibility mode)" {
	linux	/$compat boot=live components quiet findiso=\${iso_path}
	initrd	/$initrd
}
fi
EOF

if grep -qx '# You can add more entries like this' boot/grub/grub.cfg; then
    sed -i "/^# You can add more entries like this\$/r $block" boot/grub/grub.cfg
else
    cat "$block" >>boot/grub/grub.cfg
fi
