#!/bin/sh
# DebLite installer launcher. Works both from a git checkout and from the
# installed .deb (/usr/lib/deblite-installer).
set -eu

SELF_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(dirname -- "$SELF_DIR")

if [ -d "$REPO_ROOT/installer" ]; then
    PYTHONPATH="$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}"
elif [ -d /usr/lib/deblite-installer/installer ]; then
    PYTHONPATH="/usr/lib/deblite-installer${PYTHONPATH:+:$PYTHONPATH}"
fi

export PYTHONPATH
exec python3 -m installer.cli.main "$@"
