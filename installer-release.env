# Pinned DebLite installer release consumed by the ISO build.
#
# The installer lives in its own repository and is published as a .deb on
# installer-vX.Y.Z tags. Keep DEBLITE_INSTALLER_VERSION in sync with that tag.
#
# Environment variables of the same name override these values. Leave
# DEBLITE_INSTALLER_REPO empty to derive <owner>/deblite-installer from this
# repository's git origin; GitHub Actions sets it explicitly.
: "${DEBLITE_INSTALLER_REPO:=}"
: "${DEBLITE_INSTALLER_VERSION:=0.1.0}"

# Optional hard pin. Empty means verify the .deb against the release's
# SHA256SUMS asset.
: "${DEBLITE_INSTALLER_SHA256:=}"

# Optional local .deb for offline development; overrides the download.
: "${DEBLITE_INSTALLER_DEB:=}"
